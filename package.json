    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-adjust-aki": "file:modules/rehype-adjust-aki",
