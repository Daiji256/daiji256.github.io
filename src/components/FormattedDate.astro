---
type Props = {
  date: Date;
};

const { date } = Astro.props;
const formatter = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const dateStr = formatter.format(date).replaceAll('/', '-');
---

<time datetime={dateStr}>{dateStr}</time>
