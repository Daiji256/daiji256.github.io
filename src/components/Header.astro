---
import AdjustText from './AdjustText.astro';
import {
  SITE_TITLE,
  POSTS_TITLE,
  ACTIVITIES_TITLE,
  TAGS_TITLE,
} from '../consts';

const pathname = Astro.url.pathname;
const isPosts = pathname.startsWith('/posts');
const isActivities = pathname.startsWith('/activities');
const isTags = pathname.startsWith('/tags');
---

<header>
  <div class="header-content">
    <a class="title" href="/">
      <AdjustText text={SITE_TITLE} />
    </a>
    <nav>
      <ul>
        <li>
          <a
            class="nav-item"
            href="/posts/"
            aria-current={isPosts ? 'page' : undefined}
          >
            <AdjustText text={POSTS_TITLE} />
          </a>
        </li>
        <li>
          <a
            class="nav-item"
            href="/activities/"
            aria-current={isActivities ? 'page' : undefined}
          >
            <AdjustText text={ACTIVITIES_TITLE} />
          </a>
        </li>
        <li>
          <a
            class="nav-item"
            href="/tags/"
            aria-current={isTags ? 'page' : undefined}
          >
            <AdjustText text={TAGS_TITLE} />
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <hr />
</header>

<style lang="scss">
  header {
    .header-content {
      display: flex;
      align-items: baseline;
      margin: 0 auto;
      padding: 24px 0 18px 0;
      width: calc(min(100%, dimensions.$screen-wrapper-max) - 32px);

      a {
        color: inherit;
        text-decoration: none;
        border-radius: 2px;
        @include links.interactive-outline;
      }

      .title {
        font: typography.$font-title-medium;
        margin-bottom: 6px;
      }

      nav {
        font: typography.$font-label-large;
        margin-left: auto;

        ul {
          display: flex;

          li:not(:first-child) {
            margin-left: 12px;
          }

          .nav-item {
            display: inline;
          }
        }
      }
    }
  }
</style>
