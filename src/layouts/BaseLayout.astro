---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, TITLE_SEPARATOR } from '../consts';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
}

const { title: _title, description, ogType } = Astro.props;
const title =
  _title === SITE_TITLE
    ? SITE_TITLE
    : `${_title}${TITLE_SEPARATOR}${SITE_TITLE}`;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
