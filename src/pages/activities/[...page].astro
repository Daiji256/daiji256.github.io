---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentsPage from '../../components/ContentsPage.astro';
import { type ContentSummary } from '../../models/contentSummary';
import { getActivities } from '../../utils/contents';
import { paginate } from '../../utils/pagination';
import { ACTIVITIES_TITLE, ACTIVITIES_DESCRIPTION } from '../../consts';

type Props = {
  pageLength: number;
  activities: ContentSummary[];
};

export async function getStaticPaths() {
  const activities = getActivities();
  return paginate(activities).map((page) => ({
    params: page.params,
    props: {
      pageLength: page.pageLength,
      activities: page.items,
    },
  }));
}

const { page: _page } = Astro.params;
const { pageLength, activities } = Astro.props;
const page = _page ? Number(_page) : 1;
---

<BaseLayout title={ACTIVITIES_TITLE} description={ACTIVITIES_DESCRIPTION}>
  <ContentsPage
    title={ACTIVITIES_TITLE}
    contents={activities}
    page={page}
    pageLength={pageLength}
    baseUrl="/activities/"
  />
</BaseLayout>
