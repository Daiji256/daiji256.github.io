---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdjustText from '../../components/AdjustText.astro';
import { getAllTagsWithCount } from '../../utils/tags';
import { TAG_PREFIX, TAGS_TITLE, TAGS_DESCRIPTION } from '../../consts';

const tags = await getAllTagsWithCount();
---

<BaseLayout title={TAGS_TITLE} description={TAGS_DESCRIPTION}>
  <h1>
    <AdjustText text={TAGS_TITLE} />
  </h1>
  <ul class="tags">
    {tags.map((tag) => (
      <li>
        <a href={`/tags/${tag.id}/`} class="tag">
          <AdjustText text={`${TAG_PREFIX}${tag.name} (${tag.count})`} />
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style lang="scss">
  .tags {
    margin: 0 0 0 -24px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;

    .tag {
      font: typography.$font-body-medium;
      line-height: 2.5;
      margin-left: 24px;
      color: inherit;
      text-decoration: none;
      border-radius: 2px;
      @include links.interactive-outline;
    }
  }
</style>
