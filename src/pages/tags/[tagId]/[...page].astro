---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentsPage from '../../../components/ContentsPage.astro';
import { type ContentSummary } from '../../../models/contentSummary';
import { type Tag } from '../../../models/tag';
import { getAllContents } from '../../../utils/contents';
import { getAllTags, filterContentsByTag } from '../../../utils/tags';
import { paginate } from '../../../utils/pagination';

type Props = {
  tag: Tag;
  pageLength: number;
  contents: ContentSummary[];
};

export async function getStaticPaths() {
  const contents = await getAllContents();
  const tags = await getAllTags();
  return tags.flatMap((tag) => {
    const filteredContents = filterContentsByTag(contents, tag.id);
    return paginate(filteredContents).map((page) => ({
      params: {
        tagId: tag.id,
        ...page.params,
      },
      props: {
        tag,
        pageLength: page.pageLength,
        contents: page.items,
      },
    }));
  });
}

const { page: _page } = Astro.params;
const { tag, pageLength, contents } = Astro.props;
const page = _page ? Number(_page) : 1;
---

<BaseLayout
  title={tag.name}
  description={`タグ「${tag.name}」の投稿・活動一覧`}
>
  <ContentsPage
    title={tag.name}
    contents={contents}
    page={page}
    pageLength={pageLength}
    baseUrl={`/tags/${tag.id}/`}
  />
</BaseLayout>
