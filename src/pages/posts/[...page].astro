---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentsPage from '../../components/ContentsPage.astro';
import { type ContentSummary } from '../../models/contentSummary';
import { getPosts } from '../../utils/contents';
import { paginate } from '../../utils/pagination';
import { POSTS_TITLE, POSTS_DESCRIPTION } from '../../consts';

type Props = {
  pageLength: number;
  posts: ContentSummary[];
};

export async function getStaticPaths() {
  const posts = await getPosts();
  return paginate(posts).map((page) => ({
    params: page.params,
    props: {
      pageLength: page.pageLength,
      posts: page.items,
    },
  }));
}

const { page: _page } = Astro.params;
const { pageLength, posts } = Astro.props;
const page = _page ? Number(_page) : 1;
---

<BaseLayout title={POSTS_TITLE} description={POSTS_DESCRIPTION}>
  <ContentsPage
    title={POSTS_TITLE}
    contents={posts}
    page={page}
    pageLength={pageLength}
    baseUrl="/posts/"
  />
</BaseLayout>
